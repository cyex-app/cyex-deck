{
  "name": "cyex-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "tauri": "tauri",
    "ui:dev": "vite --config ui/vite.config.ts",
    "ui:build": "vite build --config ui/vite.config.ts",
    "check": "svelte-check --workspace ui --tsconfig ./tsconfig.json --fail-on-warnings",
    "test:ui": "node --experimental-strip-types --no-warnings --test \"ui/src/**/*.test.ts\""
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.2",
    "hls.js": "1.7.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tauri-apps/cli": "^2.12.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "~5.9.3",
    "vite": "^6.4.4"
  }
}
